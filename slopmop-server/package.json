{
  "name": "slopmop-server",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local scripts/dev.ts",
    "start": "tsx --env-file-if-exists=.env.local scripts/dev.ts",
    "export": "tsx --env-file-if-exists=.env.local scripts/export.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "22.x"
  }
}
