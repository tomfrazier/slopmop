# Copy to .env.local for local development (`npm run dev`). On Vercel, set these in Project Settings -> Environment Variables
# (or let the integrations add them).

# --- Jev (pick one) ---------------------------------------------------------------------------------------------
# Vercel AI Gateway: Jev is served as typesafe-ai/jev and billed through Vercel, so the key lives in Vercel.
# Create one at https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys or: vercel ai-gateway api-keys create --name slopmop
AI_GATEWAY_API_KEY=
# Or call TypeSafe directly (handy for local development). Ignored while AI_GATEWAY_API_KEY is set unless JEV_PROVIDER=direct.
# TYPESAFE_API_KEY=
# JEV_PROVIDER=gateway   # gateway | direct

# --- Storage ----------------------------------------------------------------------------------------------------
# On Vercel: add "Turso Cloud" from the Marketplace (Storage tab); it injects these. Locally, leave them unset and a
# SQLite file at data/slopmop.db is used.
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=
# SLOPMOP_DB_FILE=data/slopmop.db

# --- Behaviour (all optional) -------------------------------------------------------------------------------------
# DAILY_CHECK_LIMIT=250        # checks per install per UTC day
# STORE_CONTENT_TEXT=false     # true keeps each post's text in the registry (off: only a hash, scores and counts)
# VERDICT_MAX_AGE_DAYS=30      # reuse a stored verdict for identical content this long
# INSTALL_ID_SALT=             # set to any random string in production
# ADMIN_TOKEN=                 # the admin key: enables the dashboard at /admin, GET /api/v1/admin/stats and /admin/export. Off when unset.
#                              # Use a long random value: openssl rand -hex 32
# EVENT_RETENTION_DAYS=90      # how long per-call history (dashboard charts) is kept
# JEV_INPUT_USD_PER_M=0.042    # Jev pricing, for the dashboard's cost figures (USD per million tokens)
# JEV_OUTPUT_USD_PER_M=0
# JEV_HEDGE_MS=1500            # start a second Jev request if the first hasn't answered by then (trims the slow tail)
# JEV_ATTEMPT_TIMEOUT_MS=5000  # give up on one Jev request after this long
# JEV_MAX_ATTEMPTS=3           # total Jev requests per check, including hedges
# JEV_RATE_LIMIT_RETRIES=2     # when Jev/the gateway rate limits, wait as it asks and retry this many times
# TELL_WEIGHTS=                # PRIVATE baseline (the dashboard can override it live): JSON of per-tell weights, e.g. {"formulaicHook":0.9,"emptyEvaluation":1.25}. Unlisted tells
#                              # count 1 (the public default). Applied on the server only; clients never see it. Keep the real value
#                              # in Vercel, not in git. Tell ids: contrastFraming, emptyEvaluation, tradeoffFreePromises, formalHedging,
#                              # hypeMarketing, manneredProse, formulaicHook, manufacturedNarrative, engagementBait
# CLIENT_MAX_CONCURRENT=4      # how many requests each extension may have in flight. The server decides and sends it to clients.
# CLIENT_RATE_PER_MINUTE=120   # hard per-install requests-per-minute limit, enforced by the server (429 rate_limited + Retry-After)
# ALLOWED_ORIGINS=             # extra browser origins; extension origins are always allowed
